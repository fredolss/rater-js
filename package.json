{
  "name": "rater-js",
  "description": "Star rating widget for the browser.",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredolss/rater-js.git"
  },
  "bugs": "https://github.com/fredolss/rater-js/issues",
  "homepage": "https://fredolss.github.io/rater-js",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/rater-js.esm.js",
      "default": "./dist/rater-js.esm.js"
    }
  },
  "sideEffects": true,
  "unpkg": "./dist/rater-js.iife.min.js",
  "jsdelivr": "./dist/rater-js.iife.min.js",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && mocha && npm run test:types",
    "test:package": "node scripts/check-package.mjs",
    "test:types": "tsc --project test/types/tsconfig.json",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "star",
    "rating",
    "rater",
    "vote",
    "rate",
    "widget",
    "browser",
    "browserify",
    "typescript"
  ],
  "author": {
    "name": "Fredrik Olsson",
    "email": "fredrik.olsson2@outlook.com",
    "url": "https://github.com/fredolss"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "mocha": "^12.0.0",
    "sinon": "^22.1.0",
    "typescript": "^5.9.3"
  }
}
